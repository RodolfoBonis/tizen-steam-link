-    }
+    // Always queue a full report, even when the bytes equal the last send. The host asks for one
+    // (RequestFullReport) after a CRC mismatch to resync, and the pad state usually hasn't changed
+    // since the last send; dropping it as a duplicate leaves the host stuck on its stale copy,
+    // which fails every later delta's CRC check. Still stash it so a later delta this batch dedups
+    // against it correctly.
+    StashCurrent(holder, current, len);
     uint8_t *data = IHS_BufferPointerForAppend(&holder->dataBuffer, len);
     memcpy(data, current, len);
     holder->dataBuffer.size += len;
