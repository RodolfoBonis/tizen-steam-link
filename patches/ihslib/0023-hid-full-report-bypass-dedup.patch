+}
+
+// Stash `current` as the pending state and decide whether to skip it because the bytes are
+// byte-identical to the most recent state already queued this batch. Compares against
+// pendingCurrent (what has been added since the last flush) when there is one, else against
+// lastSent (what last went on the wire). Comparing against lastSent alone would drop a delta
+// that follows a full report in the same batch - Full(Y) then Delta(X) - and leave the host at
+// Y while the pad is at X. Returns true if the caller should drop it.
+static bool DedupAndStash(IHS_HIDReportHolder *holder, const uint8_t *current, size_t len) {
+    const uint8_t *compare = holder->pendingCurrentLen > 0 ? holder->pendingCurrent : holder->lastSent;
+    size_t compareLen = holder->pendingCurrentLen > 0 ? holder->pendingCurrentLen : holder->lastSentLen;
+    if (compare != NULL && compareLen == len && memcmp(compare, current, len) == 0) {
+        return true;
+    }
+    StashCurrent(holder, current, len);
     return false;
 }
 
