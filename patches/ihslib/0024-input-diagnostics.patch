     stats->fecRecovered = IHS_SessionCounterGet(session->counters.fecRecovered);
     stats->fecUnrecoverable = IHS_SessionCounterGet(session->counters.fecUnrecoverable);
     stats->timedOut = IHS_SessionCounterGet(session->timedOut);
+    stats->fullReportRequests = IHS_SessionCounterGet(session->counters.fullReportRequests);
+    stats->retransmitsAbandoned = IHS_SessionCounterGet(session->counters.retransmitsAbandoned);
+    stats->controlPending = IHS_SessionCounterGet(session->counters.controlPending);
+    stats->controlMaxRetransmit = IHS_SessionCounterGet(session->counters.controlMaxRetransmit);
+    stats->hidBacklogDropped = IHS_SessionCounterGet(session->counters.hidBacklogDropped);
 }
 
