Log and count the signs of an input freeze, for the log and the statistics overlay.

Several signs of input trouble left no trace. The host asks for a full HID report
(RequestFullReport) to resync after a CRC mismatch, which logged at Verbose, below the app's
Info level. A reliable packet that ran out of retransmissions was dropped with no log at all.
And the control-channel backlog, which matters once a packet can be resent for a long time
(see 0026), wasn't visible anywhere. During a controller freeze these happen, so nothing showed
why.

RequestFullReport now logs at Info with the device id, and a reliable packet dropped after its
last retransmit logs at Warn with its channel and packet id; both are rate-limited so a storm
can't flood the log. Five counters join IHS_SessionStreamStats, read through
IHS_SessionGetStreamStats and shown in the overlay: fullReportRequests and
retransmitsAbandoned (counters), and controlPending, controlMaxRetransmit and hidBacklogDropped
(gauges fed by the retransmission changes in 0025 and 0026). They live in the session, so they
stay readable after the data channels are gone.

diff --git a/include/ihslib/session.h b/include/ihslib/session.h
index d259f66..a814db3 100644
--- a/include/ihslib/session.h
+++ b/include/ihslib/session.h
@@ -241,6 +241,16 @@ typedef struct IHS_SessionStreamStats {
     uint32_t fecUnrecoverable;
     /** The session ended because the host went silent (no packets for 10 s), not by request. */
     bool timedOut;
+    /** Full HID reports the host asked for (RequestFullReport), to resync after a CRC mismatch. */
+    uint32_t fullReportRequests;
+    /** Reliable packets dropped after running out of retransmissions without an acknowledgement. */
+    uint32_t retransmitsAbandoned;
+    /** Control-channel reliable packets awaiting acknowledgement right now (a live gauge). */
+    uint32_t controlPending;
+    /** The most times any one control packet has been retransmitted this session. */
+    uint32_t controlMaxRetransmit;
+    /** HID reports dropped because the control-channel backlog hit its cap (a dead uplink). */
+    uint32_t hidBacklogDropped;
 } IHS_SessionStreamStats;
 
 void IHS_SessionGetStreamStats(const IHS_Session *session, IHS_SessionStreamStats *stats);
diff --git a/src/session/channels/control/control_hid.c b/src/session/channels/control/control_hid.c
index 7f2b28e..c9ac028 100644
--- a/src/session/channels/control/control_hid.c
+++ b/src/session/channels/control/control_hid.c
@@ -541,6 +541,15 @@ static void HandleDeviceRequestFullReport(IHS_SessionChannel *channel, IHS_HIDMa
         return;
     }
 
+    // The host asks for a full report to resync after a CRC mismatch; a steady stream of these
+    // means input is desyncing. Count every one and log at Info, rate-limited so a storm can't
+    // flood the log (the first, then every 32nd).
+    uint32_t count = IHS_SessionCounterAdd(channel->session->counters.fullReportRequests, 1) + 1;
+    if (count == 1 || count % 32 == 0) {
+        IHS_SessionLog(channel->session, IHS_LogLevelInfo, "HID",
+                       "RequestFullReport(id=%u), %u so far", cmd->device, count);
+    }
+
     if (IHS_HIDDeviceRequestFullReport(managed->device) == 0) {
         // Here we assume this device has generated one full report, and send it right away.
         // This design may require change later...
diff --git a/src/session/retransmission.c b/src/session/retransmission.c
index 14a14aa..c137464 100644
--- a/src/session/retransmission.c
+++ b/src/session/retransmission.c
@@ -150,9 +150,21 @@ static uint64_t RetransmissionTimerRun(int runCount, void *context) {
     IHS_MutexUnlock(retransmission->lock);
     if (!acked) {
         IHS_SessionPacket *packet = &pending->packet;
-        IHS_SessionQueuePacket(retransmission->session, packet,
-                               packet->header.retransmitCount < RETRANSMISSION_ATTEMPTS);
+        bool keepGoing = packet->header.retransmitCount < RETRANSMISSION_ATTEMPTS;
+        IHS_SessionChannelId channelId = packet->header.channelId;
+        uint16_t packetId = packet->header.packetId;
+        IHS_SessionQueuePacket(retransmission->session, packet, keepGoing);
         assert(packet->body.data == NULL);
+        if (!keepGoing) {
+            // Out of retransmissions and still no ACK: the packet is dropped. Count these and
+            // warn, rate-limited (the first, then every 16th).
+            uint32_t count = IHS_SessionCounterAdd(retransmission->session->counters.retransmitsAbandoned, 1) + 1;
+            if (count == 1 || count % 16 == 0) {
+                IHS_SessionLog(retransmission->session, IHS_LogLevelWarn, "Retransmission",
+                               "Gave up on Packet(channelId=%u, packetId=%u) after %d attempts, %u abandoned so far",
+                               channelId, packetId, RETRANSMISSION_ATTEMPTS, count);
+            }
+        }
     }
     return 0;
 }
diff --git a/src/session/session.c b/src/session/session.c
